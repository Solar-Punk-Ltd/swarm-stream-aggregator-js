{
  "name": "@solarpunkltd/swarm-stream-aggregator-js",
  "version": "1.0.0",
  "description": "Node.js service for aggregating Swarm stream messages (GSOC project)",
  "license": "Apache-2.0",
  "type": "module",
  "node": ">=22",
  "keywords": [
    "swarm",
    "js",
    "stream",
    "GSOC",
    "aggregator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Solar-Punk-Ltd/swarm-stream-aggregator-js"
  },
  "bugs": {
    "url": "https://github.com/Solar-Punk-Ltd/swarm-stream-aggregator-js/issues"
  },
  "author": "levente.kiss@solarpunk.buzz",
  "scripts": {
    "prepare": "husky",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ethersphere/bee-js": "^9.0.3",
    "@solarpunkltd/waku-sdk": "0.0.41",
    "@waku/utils": "^0.0.27",
    "axios": "^1.12.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "msgpack-lite": "^0.1.26",
    "p-queue": "^8.1.0",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/msgpack-lite": "^0.1.11",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^2.8.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "vitest": "3.2.4"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "pnpm": {
    "overrides": {
      "rollup": "4.62.4"
    }
  }
}
